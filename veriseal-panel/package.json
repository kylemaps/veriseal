{
  "name": "veriseal-panel",
  "displayName": "veriseal Seal Check",
  "description": "Live in-workflow badge: verify that a loaded log is sealed and authentic to its Ed25519 signer, without leaving Foxglove.",
  "publisher": "kylemaps",
  "homepage": "https://github.com/kylemaps/veriseal",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "main": "./dist/extension.js",
  "keywords": ["mcap", "ros", "integrity", "tamper-evident", "veriseal", "ed25519"],
  "scripts": {
    "build": "foxglove-extension build",
    "foxglove:prepublish": "foxglove-extension build --mode production",
    "lint": "eslint .",
    "lint:ci": "eslint .",
    "lint:fix": "eslint --fix .",
    "local-install": "foxglove-extension install",
    "package": "foxglove-extension package",
    "test": "node test/sealcore.test.mjs && node test/webverify.test.mjs"
  },
  "devDependencies": {
    "@foxglove/eslint-plugin": "2.1.2",
    "@foxglove/extension": "2.56.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "create-foxglove-extension": "1.3.2",
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3"
  }
}
